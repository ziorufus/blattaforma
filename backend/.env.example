# Email of the Google account that will be the initial administrator.
# Used only on first startup, when the database is created.
ADMIN_EMAIL=admin@example.com

# Google OAuth2 credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must be: {BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth2 credentials (https://portal.azure.com -> Entra ID -> App registrations)
# Authorized redirect URI must be: {BASE_URL}/api/auth/microsoft/callback
# MICROSOFT_TENANT_ID: "common" (default, account personali+aziendali/scuola),
# "organizations" (solo account aziendali/scuola) oppure l'ID di un tenant specifico.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Secret used to sign JWT access tokens. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret

# Public base URL of the BACKEND (no trailing slash). Used to build the
# Google OAuth2 redirect URI and to redirect back to the frontend.
BASE_URL=http://localhost:8000

# Public base URL of the FRONTEND (no trailing slash). The backend redirects
# here after a successful/failed Google login.
FRONTEND_URL=http://localhost:5173

# JWT access token lifetime in minutes. Renewed on every request.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Absolute path to the SQLite database file. Leave empty to default to
# blattaforma.db in the backend directory.
DB_PATH=

# Minimum number of minutes a model must have been idle (per Ollama's /api/ps
# "expires_at" keep-alive countdown) before it can be manually unloaded via
# the Ollama module's /unload endpoint.
OLLAMA_MAX_MINUTES=25
